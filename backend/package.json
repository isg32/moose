{
  "name": "moose-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "migrate": "node --env-file=.env.local scripts/migrate.ts",
    "deploy": "npm run build && npx -y neon@latest deploy --env .env.local",
    "test": "node --env-file=.env.local test/e2e.ts",
    "cleanup": "node --env-file=.env.local scripts/cleanup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
